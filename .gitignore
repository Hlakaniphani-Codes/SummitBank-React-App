# ============================================
# Summit Shares - Root .gitignore
# ============================================

# --- Environment Variables ---
.env
.env.local
.env.production
.env.development
.env.example

# --- Dependencies ---
node_modules/
backend/node_modules/
summit-shares/node_modules/

# --- Build Output ---
dist/
summit-shares/dist/
build/

# --- Logs ---
*.log
backend/error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Uploads (keep structure, ignore files) ---
backend/uploads/kyc/*
!backend/uploads/kyc/.gitkeep

# --- Misc ---
*.tsbuildinfo
.eslintcache
